# Backend Environment Variables

# MongoDB Connection String
# Get this from MongoDB Atlas: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://username:password@cluster-name.mongodb.net/database-name
MONGODB_URL=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/travel_agent

# JWT Secret Key for token generation
# Use a strong random string in production (min 32 characters)
JWT_SECRET=change-this-to-a-secure-random-string-in-production

# Optional: Database name (defaults to travel_agent)
# DATABASE_NAME=travel_agent

# Optional: JWT expiry in hours (defaults to 24)
# JWT_EXPIRY_HOURS=24
